[Unit]
Description=Personal Website (Flask + embedded gunicorn)
After=network.target postgresql.service
Requires=postgresql.service
# Restart forever, deliberately with no burst limit: the DB is local, so an
# outage (e.g. Postgres restarting) is expected to be brief and this unit
# should come back on its own the instant it can, with no manual restart
# needed. This means it never reaches `failed` state, so health-watch.sh's
# crash-loop check does NOT use `systemctl is-failed` — see its own comment
# for the active HTTP probe used instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=personalweb
Group=personalweb
WorkingDirectory=/opt/personal-website/current/backend
EnvironmentFile=/opt/personal-website/data/.env
Environment=APP_DATA_DIR=/opt/personal-website/data
Environment=MIGRATIONS_DIR=/opt/personal-website/current/migrations
Environment=GUNICORN_BIND=127.0.0.1:__BACKEND_PORT__
Environment=GUNICORN_GRACEFUL_TIMEOUT=30
Environment=GUNICORN_MAX_REQUESTS=1000
Environment=GUNICORN_MAX_REQUESTS_JITTER=100
ExecStart=/opt/personal-website/current/backend/server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ReadWritePaths=/opt/personal-website/data

[Install]
WantedBy=multi-user.target
