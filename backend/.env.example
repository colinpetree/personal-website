DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/personal_website
FLASK_ENV=development

# Flask session cookie signing — use any long random string in production
# generate a long string with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-flask-secret-key-here

# Fernet symmetric encryption key for storing secrets (SMTP password, Stripe key, OAuth secret)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Set to false to fully disable the AI demo feature on this deployment (no routes
# registered, admin settings hidden). Forks that don't want the AI demo section
# can also delete backend/routes/ai_demo.py and frontend/src/pages/ai-demos/.
ENABLE_AI_DEMOS=true

ANTHROPIC_API_KEY=your-anthropic-api-key
VOYAGE_API_KEY=your-voyage-api-key

# Fine-grained GitHub PAT, scoped to ONLY the repo below, with read-only
# Contents/Metadata/Pull requests permissions. Powers the MCP demo card,
# which queries this repo's live commit/branch/PR history via GitHub's
# remote MCP server. Leave unset to disable that card (503, same as a
# missing ANTHROPIC_API_KEY).
GITHUB_MCP_TOKEN=your-fine-grained-github-pat
# owner/repo this demo is scoped to talk about.
GITHUB_MCP_REPO=colinpetree/personal-website

# --- Production deployment only (see deploy plan / PLAN.md §7 & §9) --------
# Uncomment and set these when running via backend/server.py in production.
# Local dev (python app.py) ignores all of them and falls back to sane
# defaults, so they're commented out here.

# Comma-separated list of origins allowed to make credentialed cross-origin
# requests (CORS). Local dev defaults to the Vite dev server if unset. Set
# this to the site's real domain(s) in production, e.g.:
# FRONTEND_ORIGIN=https://example.com
# FRONTEND_ORIGIN=https://example.com,https://www.example.com

# Persistent runtime data directory (uploads, certbot_domain.txt, RAG cache).
# Defaults to the app's own install directory if unset — must be set to a
# stable path outside the versioned release dir in production.
# APP_DATA_DIR=/opt/personal-website/data

# Base URL of the local Varnish instance for cache purge/ban requests on
# content changes. Leave unset to disable purging entirely (local dev default).
# VARNISH_PURGE_URL=http://127.0.0.1:6081

# gunicorn tuning (server.py reads these; see deploy/systemd/personal-website.service)
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100

# Shared secret for POST /api/watcher-alert — lets the build Pi's
# content-watch.sh email an alert (via this site's own Mailgun config) when
# its gh auth has been broken for an extended period. Generate once with:
# openssl rand -hex 32
# Copy the SAME value into the Pi's ~/.personal-website-build.env. Leave
# unset to disable the endpoint (it always returns 403 rather than a silent
# no-op).
# WATCHER_ALERT_SECRET=

# Optional fallback Mailgun config for watcher alerts (backend/watcher_alerts.py),
# used if the normal SiteConfig-backed Mailgun path doesn't work for any
# reason — the database is unreachable, or the primary Mailgun account
# itself is broken (expired/revoked key, suspended account, rate-limited).
# Deliberately plain env vars, not stored/encrypted in the database, so this
# path has no dependency on the thing it may be reporting as down. Leave
# unset to skip this fallback entirely (the primary SiteConfig path still
# works normally).
#
# Use a genuinely SEPARATE Mailgun account here, not just a second API key
# on the same account as the primary — a second key on the same account
# doesn't help if that account gets suspended, hits a sending/billing issue,
# or gets abuse-flagged, since both "primary" and "fallback" would then be
# the same broken account under two names. A free-tier account dedicated
# solely to this is enough; the whole point is that whatever breaks the
# primary has to independently also break something unrelated.
# WATCHER_ALERT_FALLBACK_MAILGUN_API_KEY=
# WATCHER_ALERT_FALLBACK_MAILGUN_DOMAIN=
# WATCHER_ALERT_FALLBACK_FROM_EMAIL="Watcher Alert <alerts@example.com>"
# WATCHER_ALERT_FALLBACK_TO_EMAIL=you@example.com

# Nightly Postgres + data-dir backup (deploy/scripts/backup.sh, see
# deploy/BACKUP.md) into a local restic repository. Old snapshots are
# pruned after this many days (restic forget --keep-daily).
# BACKUP_RETENTION_DAYS=14
# restic repository password — generated once by deploy/scripts/setup-restic-repo.sh.
# The Pi (which pulls this repo nightly, since production has no route back
# into the Pi's network) needs a copy of this same value in its own
# ~/.personal-website-build.env — see deploy/scripts/setup-backup-pull-pi.sh.
# RESTIC_PASSWORD=

# Shared threshold for personal-website-healthwatch.timer's disk-usage check
# (deploy/scripts/health-watch.sh) — alerts once/day if / or the app data
# directory exceeds this percent used.
# BACKUP_DISK_ALERT_PERCENT=85

# How many days before the live TLS certificate's expiry
# personal-website-healthwatch.timer should alert if it hasn't been renewed
# yet (a sign certbot.timer has silently stopped working).
# CERT_ALERT_DAYS=14

# Orphan media cleanup (deploy/scripts/media-cleanup.sh, see deploy/BACKUP.md)
# — deletes uploaded files no longer referenced by any post/page/avatar/
# favicon. A file is never deleted the first time it looks unreferenced; it's
# only removed after being unreferenced continuously for this many days
# (an admin recreating deleted content, or restoring a removed image, within
# this window cancels the pending deletion). Deliberately shorter than
# BACKUP_RETENTION_DAYS so every file this job ever deletes is still
# recoverable from a backup snapshot for a while after deletion too.
# ORPHAN_MEDIA_GRACE_DAYS=7
# Circuit breaker: if a single run would newly flag OR actually delete more
# than this many files, it aborts and changes nothing instead of proceeding
# — a much more likely sign of a bug in the reference-scanning logic than of
# a genuine bulk cleanup. Ordinary nightly runs should be in the 0-3 file
# range.
# ORPHAN_MEDIA_MAX_PER_RUN=20
