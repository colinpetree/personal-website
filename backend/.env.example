DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/personal_website
FLASK_ENV=development

# Flask session cookie signing — use any long random string in production
SECRET_KEY=your-flask-secret-key-here

# Fernet symmetric encryption key for storing secrets (SMTP password, Stripe key, OAuth secret)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

ANTHROPIC_API_KEY=your-anthropic-api-key
VOYAGE_API_KEY=your-voyage-api-key
